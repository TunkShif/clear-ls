# Generates `ClearLS::Syntax::Kind` and `ClearLS::Syntax::Field` from the
# grammar's node-types.json.
#
#   crystal run tools/gen_syntax.cr -- NODE_TYPES_JSON OUTPUT_CR
#
# Kinds cover named node types only. Anonymous tokens map to
# `Kind::Anonymous` and are matched by their text when needed.
require "json"

input, output = ARGV[0]?, ARGV[1]?
abort "usage: gen_syntax NODE_TYPES_JSON OUTPUT_CR" unless input && output

types = JSON.parse(File.read(input)).as_a
named = types.select(&.["named"].as_bool).map(&.["type"].as_s).uniq.sort!
fields = types.flat_map { |t| t["fields"]?.try(&.as_h.keys) || [] of String }.uniq.sort!

# Kinds that would shadow top-level stdlib types inside the enum get a suffix.
RESERVED = %w(Nil Self True False String Char Array Hash Tuple Range Regex
  Symbol Proc Float Union Enum Class Struct Pointer Alias Annotation Int)

def member(name : String) : String
  base = name.camelcase
  RESERVED.includes?(base) ? "#{base}Node" : base
end

def write_enum(io, name, header, specials, values)
  io << "  # " << header << "\n"
  io << "  enum " << name << " : UInt16\n"
  specials.each { |s| io << "    " << s << "\n" }
  values.each { |v| io << "    " << member(v) << "\n" }
  io << "  end\n\n"
  io << "  # Grammar names, indexed by `" << name << "#value`.\n"
  io << "  " << name.upcase << "_NAMES = [\n"
  specials.size.times { io << "    \"\",\n" }
  values.each { |v| io << "    " << v.inspect << ",\n" }
  io << "  ] of ::String\n"
end

code = String.build do |io|
  io << "# Code generated by tools/gen_syntax.cr from tree-sitter-crystal\n"
  io << "# node-types.json. DO NOT EDIT; run `make syntax-gen`.\n\n"
  io << "module ClearLS::Syntax\n"
  write_enum(io, "Kind", "Named node kinds of the Crystal grammar.",
    %w(Anonymous Error Unknown), named)
  io << "\n"
  write_enum(io, "Field", "Field names of the Crystal grammar.", %w(None), fields)
  io << "end\n"
end

File.write(output, code)
puts "wrote #{output}: #{named.size} kinds, #{fields.size} fields"
