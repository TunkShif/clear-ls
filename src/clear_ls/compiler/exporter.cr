module ClearLS::Compiler
  # Extra source added to diagnostic compiles that prints what the compiler
  # knows after macro expansion:
  #
  # ```text
  # clear-ls:M <owner> <class?> <visibility> <file>:<line>:<column> <def header>
  # clear-ls:MEND
  # clear-ls:I <owner> <@ivar> <type>
  # clear-ls:IEND
  # ```
  #
  # Methods come from `macro finished` (after all hooks and `{% for %}`
  # loops ran). Ivar types are only available once instance variables are
  # typed, i.e. inside a method body, so the second part is a macro inside
  # a def that is called at the top level. Everything stays in one `{% %}`
  # tag: macro variables do not survive between tags of a def body, and
  # referring to a type by name would fail for private types.
  #
  # Only methods and ivars of types with code under *root* (workspace and
  # shards) are printed; the stdlib is indexed from source.
  module Exporter
    PREFIX = "clear-ls:"

    def self.source(root : String) : String
      root = root.ends_with?('/') ? root : root + "/"
      <<-CRYSTAL
      # Generated by clear-ls (compiler facts exporter).
      macro finished
        {%
          __cl_root = #{root.inspect}
          __cl_types = [@top_level] of TypeNode
          __cl_queue = @top_level.constants.map { |c| @top_level.constant(c) }.select(&.is_a?(TypeNode))
          __cl_queue.each do |t|
            unless __cl_types.includes?(t)
              __cl_types << t
              t.constants.each { |c| x = t.constant(c); __cl_queue << x if x.is_a?(TypeNode) }
            end
          end
          __cl_types.each do |t|
            owner = t == @top_level ? "" : t.name(generic_args: false)
            [{t.methods, false}, {t == @top_level ? [] of Def : t.class.methods, true}].each do |(defs, cls)|
              defs.each do |m|
                if m.filename && m.filename.starts_with?(__cl_root)
                  args = m.args.map_with_index { |a, i| (i == m.splat_index ? "*" : "") + a.stringify }
                  args << "**\#{m.double_splat}" if m.double_splat
                  args << "&\#{m.block_arg}" if m.block_arg
                  header = "\#{m.name}(\#{args.join(", ").id})"
                  header += " : \#{m.return_type}" if m.return_type
                  header += " forall \#{m.free_vars.join(", ").id}" unless m.free_vars.empty?
                  puts "#{PREFIX}M\\t\#{owner.id}\\t\#{cls}\\t\#{m.visibility.id}\\t\#{m.filename.id}:\#{m.line_number}:\#{m.column_number}\\t\#{header.id}"
                end
              end
            end
          end
          puts "#{PREFIX}MEND"
        %}

        def __clear_ls_facts
          \\{%
            __cl_root = #{root.inspect}
            __cl_types = [] of TypeNode
            __cl_queue = @top_level.constants.map { |c| @top_level.constant(c) }.select(&.is_a?(TypeNode))
            __cl_queue.each do |t|
              unless __cl_types.includes?(t)
                __cl_types << t
                t.constants.each { |c| x = t.constant(c); __cl_queue << x if x.is_a?(TypeNode) }
              end
            end
            __cl_types.each do |t|
              if (t.class? || t.struct?) && t.type_vars.empty? && t.methods.any? { |m| m.filename && m.filename.starts_with?(__cl_root) }
                t.instance_vars.each { |v| puts "#{PREFIX}I\\t\#{t.name(generic_args: false).id}\\t@\#{v.name}\\t\#{v.type}" }
              end
            end
            puts "#{PREFIX}IEND"
          %}
        end

        __clear_ls_facts
      end
      CRYSTAL
    end

    record MethodFact, owner : String, class_level : Bool, visibility : String,
      file : String, line : Int32, column : Int32, header : String

    record IvarFact, owner : String, name : String, type : String

    # Parsed exporter output. A section is nil when the compile stopped
    # before printing all of it (the previous facts stay valid then).
    record Facts, methods : Array(MethodFact)?, ivars : Array(IvarFact)? do
      def self.parse(stdout : String) : Facts
        methods = [] of MethodFact
        ivars = [] of IvarFact
        mend = iend = false
        stdout.each_line do |line|
          next unless line.starts_with?(PREFIX)
          f = line.lchop(PREFIX).split('\t')
          case f[0]
          when "M"
            next unless f.size >= 6
            loc = f[4].split(':')
            col = loc.pop.to_i? || next
            ln = loc.pop.to_i? || next
            methods << MethodFact.new(f[1], f[2] == "true", f[3], loc.join(':'), ln, col, f[5..].join('\t'))
          when "I"
            ivars << IvarFact.new(f[1], f[2], f[3]) if f.size >= 4
          when "MEND" then mend = true
          when "IEND" then iend = true
          end
        end
        new(mend ? methods : nil, iend ? ivars : nil)
      end
    end
  end
end
