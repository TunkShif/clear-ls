require "./h"
# low_level_primitives.md, pointerof.md, sizeof.md, ..., class/type reflection
class Dog
  @x = 1
  def bark; "w"; end
end
x = 1
d = Dog.new
u = cond ? 1 : "s"
n = cond ? 1 : nil
# .class
__t(d.class)
__t(x.class)
__t(u.class)
__t(Dog.class)
__t(Dog.name)
__t(d.class.name)
__t(Int32.class.name)
# pointers
__t(Pointer(Int32).malloc(1))
__t(Pointer(Int32).malloc(2, 0))
__t(Pointer(Int32).null)
__t(Pointer(Int32).new(0_u64))
__t(pointerof(x))
__t(pointerof(x).value)
__t(pointerof(x) + 1)
__t(pointerof(d.@x))
__t(x.unsafe_as(Float32))
# sizes
__t(sizeof(Int32))
__t(instance_sizeof(Dog))
__t(alignof(Int64))
__t(instance_alignof(Dog))
__t(offsetof(Dog, @x))
# equality and comparison
__t(x == 1)
__t(x == 1.5)
__t(x != 2)
__t(x === 1)
__t("a" == "b")
__t(d == d)
__t(u == 1)
__t(:a == :b)
__t([1] == [2])
__t(x <=> 2)
__t(1.5 <=> x)
# number operators generated by macros
a = 1; b = 1_i64; c = 1.5_f32; f = 1.5; e = 1_u8
__t(a / a)
__t(a / b)
__t(a / c)
__t(a / f)
__t(c / a)
__t(c / f)
__t(f / c)
__t(e / e)
__t(a // b)
__t(f // a)
__t(c // f)
__t(e % a)
__t(f % a)
__t(a.fdiv(2))
# special variables
if "abc" =~ /(b)/
  __t($~)
  __t($1)
  __t($1?)
end
__t("abc" =~ /b/)
# try
__t(1.try { |v| v.to_s })
__t(nil.try { |v| 1 })
__t(n.try { |v| v.to_s })
__t(n.try &.abs)
# select, spawn
ch = Channel(Int32).new
sel = select
when v = ch.receive?
  __t(v)
  v
when timeout(1.second)
  "t"
end
__t(sel)
__t(spawn { }) # cls: ?  def inside {% begin %} with a macro in its params (book-gaps N)
