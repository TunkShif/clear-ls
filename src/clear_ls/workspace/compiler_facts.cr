require "../items"
require "../semantics/def_map"
require "../compiler/exporter"

module ClearLS::Workspace
  # Compiler-reported methods and ivar types merged into a `DefMap`.
  #
  # Only facts that the source index lacks are added: methods generated by
  # macro hooks, `{% for %}` loops, or unknown macros (`JSON::Serializable`),
  # and types of ivars that are never declared. Added items have origin
  # `Compiler` and point at the code that generated them.
  class CompilerFacts
    getter methods : Array(ClearLS::Compiler::Exporter::MethodFact)
    getter ivars : Array(ClearLS::Compiler::Exporter::IvarFact)
    # Digest of each method fact file's text when the facts were taken. A
    # file saved since then has moved lines, so its facts are skipped until
    # the next check.
    getter digests : Hash(String, UInt64)

    def initialize(@methods = [] of ClearLS::Compiler::Exporter::MethodFact, @ivars = [] of ClearLS::Compiler::Exporter::IvarFact,
                   @digests = {} of String => UInt64)
    end

    # Facts with the digests of the files they refer to, as on disk now.
    def self.snapshot(methods, ivars) : CompilerFacts
      digests = {} of String => UInt64
      methods.each do |m|
        next if digests.has_key?(m.file)
        digests[m.file] = File.read(m.file).hash if File.file?(m.file)
      end
      new(methods, ivars, digests)
    end

    def empty? : Bool
      @methods.empty? && @ivars.empty?
    end

    def ==(other : CompilerFacts) : Bool
      @methods == other.methods && @ivars == other.ivars && @digests == other.digests
    end

    # Adds the facts to *map*. *file_id* interns a path; *text* reads the
    # (saved) text of a file to convert compiler locations to offsets.
    # Returns the number of added members.
    # Only facts located in *visible* files (the map's view) apply.
    def apply(map : Semantics::DefMap, file_id : String -> FileId, text : String -> String?, visible : Set(FileId)? = nil) : Int32
      signatures = parse_headers
      files = {} of String => {FileId, LineIndex?}
      added = 0
      @methods.each_with_index do |f, i|
        parsed = signatures[i]? || next
        owner = owner_type(map, f.owner) || next
        next if map[owner].kind.lib? # `fun`s are indexed from source
        file, index = files.fetch(f.file) { files[f.file] = {file_id.call(f.file), line_index(f.file, text)} }
        index || next
        next if visible && !visible.includes?(file)
        offset = index.offset(LineCol.new((f.line - 1).to_u32, (f.column - 1).to_u32), PositionEncoding::UTF32)
        item = method_item(parsed, f, index, offset)
        next if declared?(map, owner, file, item, offset)
        map.add_synthetic(owner, file, item)
        added += 1
      end
      @ivars.each do |f|
        owner = owner_type(map, f.owner) || next
        # Declared ivars win; ivars typed only from `@x = v` assignments in
        # defs (`Origin::Assigned`) take the compiler's type instead.
        next if map.ancestors(owner).any? { |a| map[a].members[f.name]?.try &.any? { |s| s.item.kind.instance_var? && !s.item.origin.assigned_or_param? } }
        info = map[owner]
        site = info.sites.first? || next
        next if visible && !visible.includes?(site.file)
        item = Items::Item.new(Items::ItemKind::InstanceVar, f.name, site.item.name_range, site.item.name_range,
          origin: Items::Origin::Compiler, detail: f.type)
        map.add_synthetic(owner, site.file, item)
        added += 1
      end
      added
    end

    private def line_index(path : String, text : String -> String?) : LineIndex?
      mtime = File.info?(path).try(&.modification_time)
      cached = @lines[path]?
      return cached[1] if cached && cached[0] == mtime
      index = text.call(path).try { |t| LineIndex.new(t) if @digests[path]?.nil? || @digests[path] == t.hash }
      # An open buffer that differs from disk is not cached (it may be saved
      # back to the same text).
      @lines[path] = {mtime, index} if index
      index
    end

    private def owner_type(map : Semantics::DefMap, name : String) : Semantics::TypeId?
      name.empty? ? Semantics::DefMap::PROGRAM : map.lookup_path("::" + name)
    end

    # Every header as a def, parsed in one source: index i → the def item
    # of fact i (nil when it did not parse as one def).
    # Parsed once per facts object: facts change after a check, the DefMap
    # is rebuilt on every declaration edit.
    @headers : Array(Items::Item?)? = nil
    # Line index per fact file, keyed by modification time (nil: the text
    # no longer matches the facts).
    @lines = {} of String => {Time?, LineIndex?}

    private def parse_headers : Array(Items::Item?)
      @headers ||= parse_headers_uncached
    end

    private def parse_headers_uncached : Array(Items::Item?)
      starts = [] of Int32
      src = String.build do |io|
        @methods.each do |f|
          starts << io.bytesize
          io << "def " << (f.class_level ? "self." : "") << f.header << "\nend\n"
        end
      end
      items = Items::Lower.lower(Syntax::Parser.new.parse(src)).items
      by_start = items.to_h { |it| {it.range.start.to_i32, it} }
      starts.map do |s|
        it = by_start[s]?
        it if it && it.kind.def? && it.name != "?"
      end
    end

    # A def item from the parsed header; its ranges are the generating
    # code's identifier at *offset*.
    private def method_item(parsed : Items::Item, f : ClearLS::Compiler::Exporter::MethodFact, index : LineIndex, offset : UInt32) : Items::Item
      range = word_range(index.text, offset)
      vis = case f.visibility
            when "private"   then Items::Visibility::Private
            when "protected" then Items::Visibility::Protected
            else                  Items::Visibility::Public
            end
      Items::Item.new(Items::ItemKind::Def, parsed.name, range, range, visibility: vis,
        origin: Items::Origin::Compiler, signature: parsed.signature)
    end

    # Already known from source: a member of the same name declared around
    # the location (a source def, or a known macro's synthesised def), or
    # the `initialize` a generated `new` comes from.
    private def declared?(map : Semantics::DefMap, owner : Semantics::TypeId, file : FileId, item : Items::Item, offset : UInt32) : Bool
      class_level = !item.signature.try(&.receiver).nil?
      names = [Semantics::DefMap.member_key(item.name, class_level)]
      names << "initialize" if class_level && item.name == "new"
      names.any? do |key|
        map[owner].members[key]?.try &.any? { |s| s.file == file && s.item.range.start <= offset < Math.max(s.item.range.end, s.item.range.start + 1) }
      end
    end

    private def word_range(text : String, offset : UInt32) : TextRange
      bytes = text.to_slice
      stop = offset
      while stop < bytes.size && (bytes[stop].unsafe_chr.ascii_alphanumeric? || bytes[stop] == '_'.ord || bytes[stop] >= 0x80)
        stop += 1
      end
      stop = offset + 1 if stop == offset && offset < bytes.size
      TextRange.new(offset, stop)
    end
  end
end
