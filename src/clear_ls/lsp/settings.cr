require "json"
require "log"

module ClearLS::LSP
  # Every server setting: one table drives defaults, validation, typed
  # access and `docs/settings.md` (`clear-ls settings-doc`; a spec checks
  # the doc is current).
  #
  # Read from `initializationOptions` at `initialize`, then from
  # `workspace/didChangeConfiguration` (`settings.clearLs`, or `settings`
  # itself when the client sends the section unwrapped). A key that is
  # absent keeps its default; a key of the wrong type or unknown is
  # logged once and ignored.
  class Settings
    Log = ::Log.for("clear-ls.settings")

    enum Kind
      Bool
      Int
      Float
      String
      StringArray
      Enum
    end

    record Key, path : String, kind : Kind, default : JSON::Any, doc : String,
      choices : Array(String) = [] of String, restart : Bool = false

    private macro k(path, kind, default, doc, choices = [] of String, restart = false)
      Key.new({{path}}, Kind::{{kind.id}}, JSON::Any.new({{default}}), {{doc}}, {{choices}}, {{restart}})
    end

    KEYS = [
      k("compiler.enabled", Bool, true, "Background `crystal build --no-codegen` checks (diagnostics, compiler facts). Formatting and macro expansion use the compiler regardless.", restart: true),
      k("compiler.path", String, nil, "The `crystal` executable (default `$CRYSTAL`, else `crystal` on `PATH`).", restart: true),
      k("compiler.entries", StringArray, nil, "Programs to check, relative to the root, instead of the `shard.yml` targets.", restart: true),
      k("compiler.debounceMs", Int, 150_i64, "Delay before a check after a save, in milliseconds.", restart: true),
      k("compiler.facts", Bool, true, "Add the facts exporter to each check: methods generated by macros and ivar types from the compiler.", restart: true),
      k("compiler.contextHover", Bool, true, "Hover on a local in a saved file asks `crystal tool context` for its types."),
      k("references.includePossible", Bool, false, "References also list uses whose receiver type is unknown (same name, identity not confirmed)."),
      k("budgets.references", Float, 5.0, "Seconds a references search may run before it stops with a message (0: no limit)."),
      k("budgets.rename", Float, 5.0, "Same for rename."),
      k("budgets.incomingCalls", Float, 5.0, "Same for incoming calls."),
      k("budgets.maxCandidates", Int, 2000_i64, "Most candidate files one search reads; over it the search fails with a message."),
      k("cache.enabled", Bool, true, "Persistent index cache (global stdlib/shard packs, project `.clear-ls/cache/`). `--no-cache` turns it off.", restart: true),
      k("cache.dir", String, nil, "Global cache directory (default `$CLEAR_LS_CACHE_DIR`, else the platform cache dir + `clear-ls`).", restart: true),
      k("inlayHints.enabled", Bool, true, "All inlay hints."),
      k("inlayHints.locals", Bool, true, "Type after a local's first assignment (`x = foo` → `x : Int32`), unless obvious from the value (a literal, `T.new`)."),
      k("inlayHints.blockParams", Bool, true, "Types of block parameters (`each { |x| }` → `x : String`)."),
      k("inlayHints.aliases", Bool, true, "Spell types written as an alias with its name (`alias Id = Int32 | String`: `x : Id`, `xs : Array(Id)`, `xs.first : Id`), in hints and hover; hover adds the expansion. A value that mixes the alias with the plain type shows the expansion. False always shows the expansion (as the compiler does)."),
      k("inlayHints.returnTypes", Bool, true, "Inferred return type after the parameter list of defs written without one."),
      k("completion.blockSnippets", Bool, true, "Completing a method whose every overload takes a block inserts one (`xs.ma` → `xs.map { |x| }`, parameter names from the method's `yield` when they are plain names, else placeholders). Methods with a non-block overload (`select`, `count`) complete as names. Needs client snippet support."),
      k("completion.blockStyle", Enum, "braces", "Form of block snippets: `{ |x| }` or `do |x| ... end` on new lines.", ["braces", "do"]),
      k("completion.setterSnippets", Bool, true, "Completing `name=` after `x.` writes `x.name = ` (the setter as it is called); binary operators write `x + `, index operators `x[]`. False keeps the method names (`x.name=`, `x.+`)."),
      k("warmup.enabled", Bool, true, "Infer workspace bodies in the background while idle, so the first references search is fast."),
    ]

    @values = {} of String => JSON::Any
    @warned = Set(String).new

    def initialize
      KEYS.each { |key| @values[key.path] = key.default }
    end

    # Applies a settings object (nested, `{"compiler": {"enabled": false}}`).
    # Returns the keys whose value changed.
    def apply(obj : JSON::Any?) : Array(String)
      changed = [] of String
      return changed unless obj && (h = obj.as_h?)
      walk(h, "") do |path, value|
        key = KEYS.find { |k| k.path == path }
        unless key
          warn(path, "unknown setting `#{path}`, ignored")
          next
        end
        unless valid?(key, value)
          warn(path, "setting `#{path}`: expected #{describe(key)}, got #{value.to_json}; using #{@values[path].to_json}")
          next
        end
        value = JSON::Any.new(value.as_i64.to_f) if key.kind.float? && value.as_i64?
        if @values[path] != value
          @values[path] = value
          changed << path
        end
      end
      changed
    end

    def bool(path : String) : Bool
      @values[path].as_bool
    end

    def int(path : String) : Int64
      @values[path].as_i64
    end

    def float(path : String) : Float64
      v = @values[path]
      v.as_f? || v.as_i64.to_f
    end

    def string?(path : String) : String?
      @values[path].as_s?
    end

    def strings?(path : String) : Array(String)?
      @values[path].as_a?.try &.map(&.as_s)
    end

    private def walk(h : Hash(String, JSON::Any), prefix : String, &block : String, JSON::Any ->) : Nil
      h.each do |name, value|
        path = prefix.empty? ? name : "#{prefix}.#{name}"
        if (inner = value.as_h?) && KEYS.none? { |k| k.path == path }
          walk(inner, path, &block)
        else
          block.call(path, value)
        end
      end
    end

    private def valid?(key : Key, v : JSON::Any) : Bool
      return true if v.raw.nil? && key.default.raw.nil?
      case key.kind
      in .bool?         then !v.as_bool?.nil?
      in .int?          then !v.as_i64?.nil?
      in .float?        then !(v.as_f? || v.as_i64?).nil?
      in .string?       then !v.as_s?.nil?
      in .string_array? then v.as_a?.try(&.all?(&.as_s?)) || false
      in .enum?         then v.as_s?.try { |s| key.choices.includes?(s) } || false
      end
    end

    private def describe(key : Key) : String
      key.kind.enum? ? key.choices.map(&.inspect).join(" or ") : key.kind.to_s.underscore.gsub('_', ' ')
    end

    private def warn(path : String, msg : String) : Nil
      Log.warn { msg } if @warned.add?(path)
    end

    # Markdown reference (docs/settings.md), generated from `KEYS`.
    def self.markdown : String
      String.build do |io|
        io << "# Settings\n\n"
        io << "<!-- Generated by `clear-ls settings-doc` from `src/clear_ls/lsp/settings.cr`; edit there. -->\n\n"
        io << "Pass them as `initializationOptions` when the client starts the server, or\n"
        io << "send them later with `workspace/didChangeConfiguration` (`{\"settings\": {\"clearLs\": {...}}}`).\n"
        io << "Nested objects: `compiler.enabled` is `{\"compiler\": {\"enabled\": ...}}`. Unknown keys\n"
        io << "and wrong types are logged and ignored. Settings marked *restart* are read once, at startup.\n\n"
        sections = KEYS.group_by { |key| key.path.split('.').first }
        sections.each do |section, keys|
          io << "## `" << section << "`\n\n"
          io << "| Key | Type | Default | |\n|---|---|---|---|\n"
          keys.each do |key|
            type = key.kind.enum? ? key.choices.map { |c| "`#{c.inspect}`" }.join(" | ") : key.kind.to_s.underscore.gsub('_', ' ')
            default = key.default.raw.nil? ? "—" : "`#{key.default.to_json}`"
            io << "| " << cell("`#{key.path}`") << " | " << cell(type) << " | " << cell(default) << " | " << cell(key.doc)
            io << " *restart*" if key.restart
            io << " |\n"
          end
          io << '\n'
        end
        io << NEOVIM
      end
    end

    # A table cell: GFM splits rows at `|` before parsing code spans, so a
    # `|` must be escaped even inside backticks (`{ \|x\| }` renders as
    # `{ |x| }`).
    private def self.cell(text : String) : String
      text.gsub('|', "\\|")
    end

    NEOVIM = <<-MD
      ## Neovim

      Neovim 0.11+ with the built-in LSP client (`~/.config/nvim/lsp/clear_ls.lua`,
      then `vim.lsp.enable("clear_ls")`):

      ```lua
      return {
        cmd = { "clear-ls", "lsp" },          -- add "--log-file", "/tmp/clear-ls.log" to debug
        filetypes = { "crystal" },
        root_markers = { "shard.yml", ".git" },
        init_options = {
          inlayHints = { blockParams = true },
          completion = { blockStyle = "braces" },
        },
        -- settings are sent with workspace/didChangeConfiguration:
        settings = { clearLs = {} },
      }
      ```

      Inlay hints are off in Neovim until enabled: `vim.lsp.inlay_hint.enable(true)`.

      ### Completion without parentheses (blink.cmp)

      clear-ls completes method names without `(`, the usual Crystal call style
      (`puts "foo"`, `item.name`). blink.cmp adds `()` to every method item
      unless the filetype is blocked (it blocks `ruby` by default, not
      `crystal`). Block it:

      ```lua
      require("blink.cmp").setup({
        completion = {
          accept = { auto_brackets = { blocked_filetypes = { "crystal" } } },
        },
      })
      ```

      This turns off both of blink's bracket checks (by item kind and by
      semantic token) for Crystal. Snippets from clear-ls (blocks, setters)
      bring their own brackets and are not affected. nvim-cmp adds no
      brackets unless `nvim-autopairs`' cmp integration is set up; exclude
      Crystal there: `cmp_autopairs.on_confirm_done({ filetypes = { crystal = false } })`.

      MD
  end
end
